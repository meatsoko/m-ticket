# =========================
# Next.js / Supabase
# =========================

# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =========================
# Daraja / M-Pesa
# =========================

# sandbox or production
DARAJA_ENV=sandbox

DARAJA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
DARAJA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET

# Shortcode / Till / PayBill used for STK Push
DARAJA_SHORTCODE=YOUR_SHORTCODE

# Lipa Na M-Pesa Online passkey
DARAJA_PASSKEY=YOUR_DARAJA_PASSKEY

# Must be publicly reachable by Safaricom
DARAJA_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/daraja-callback

# Optional: transaction type, depending on your Daraja setup
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline
