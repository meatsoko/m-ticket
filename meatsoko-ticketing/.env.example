# =========================
# Next.js / Supabase
# =========================

# Public Supabase project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Supabase anon/public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Public URL of the deployed app
NEXT_PUBLIC_APP_URL=http://localhost:3000


# =========================
# Daraja / M-Pesa
# =========================

# sandbox or production
DARAJA_ENV=sandbox

DARAJA_CONSUMER_KEY=YOUR_DARAJA_CONSUMER_KEY
DARAJA_CONSUMER_SECRET=YOUR_DARAJA_CONSUMER_SECRET

# Shortcode / Till / PayBill used for STK Push
DARAJA_SHORTCODE=YOUR_SHORTCODE

# Lipa Na M-Pesa Online passkey
DARAJA_PASSKEY=YOUR_DARAJA_PASSKEY

# Must be publicly reachable by Safaricom
DARAJA_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/daraja-callback

# Optional: transaction type, depending on your Daraja setup
DARAJA_TRANSACTION_TYPE=CustomerPayBillOnline

# =========================
# Paystack hosted checkout
# =========================

# Server-side secret key only. Set it as a Supabase Edge Function secret for deployment.
# Configure this webhook URL in the Paystack dashboard:
# https://YOUR_PROJECT_REF.supabase.co/functions/v1/paystack-webhook
PAYSTACK_SECRET_KEY=sk_test_your_secret_key


# =========================
# PayHero (M-Pesa STK, alongside Paystack) — Supabase Edge Function secrets
# =========================
# From the PayHero dashboard: API Keys (username + password) and Payment Channels.
# Set with `supabase secrets set`; never NEXT_PUBLIC_. PAYHERO_PAYMENTS=on opens payments.
PAYHERO_API_USERNAME=
PAYHERO_API_PASSWORD=
PAYHERO_CHANNEL_ID=
PAYHERO_PAYMENTS=off
# Site flag (Vercel): shows the "Pay with M-Pesa" option.
NEXT_PUBLIC_PAYHERO_PAYMENTS=off


# =========================
# Edge function extras
# =========================

# Public app origin used inside emailed ticket links (edge functions cannot read
# NEXT_PUBLIC_* vars — set this as a Supabase secret too).
APP_URL=https://your-domain

# REQUIRED in practice. Guests must now supply an email so their pass and QR can be
# delivered; with no key set they are asked for an address and then receive nothing.
# The from-domain must be verified with Resend or mail silently bounces.
RESEND_API_KEY=
TICKET_EMAIL_FROM=info@meatsokogroup.com
